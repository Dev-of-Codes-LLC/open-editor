{
  "name": "@devofcodes/editor",
  "version": "0.1.0",
  "private": true,
  "description": "One createEditor call for two kinds of writing: source code on CodeMirror 6, and prose on Tiptap and ProseMirror. Plus a small developer workspace over a host file store.",
  "license": "Apache-2.0",
  "type": "module",
  "sideEffects": [
    "*.css"
  ],
  "files": [
    "dist",
    "NOTICE"
  ],
  "exports": {
    ".": {
      "types": "./dist/types/index.d.ts",
      "default": "./dist/index.js"
    },
    "./code": {
      "types": "./dist/types/code/index.d.ts",
      "default": "./dist/code.js"
    },
    "./manuscript": {
      "types": "./dist/types/manuscript/index.d.ts",
      "default": "./dist/manuscript.js"
    },
    "./markdown": {
      "types": "./dist/types/manuscript/markdown.d.ts",
      "default": "./dist/markdown.js"
    },
    "./book": {
      "types": "./dist/types/book/index.d.ts",
      "default": "./dist/book.js"
    },
    "./files": {
      "types": "./dist/types/files.d.ts",
      "default": "./dist/files.js"
    },
    "./code-workspace": {
      "types": "./dist/types/workspace/code.d.ts",
      "default": "./dist/code-workspace.js"
    },
    "./manuscript.css": "./dist/manuscript.css",
    "./code-workspace.css": "./dist/code-workspace.css"
  },
  "scripts": {
    "build": "node build.mjs && tsc -p tsconfig.json --emitDeclarationOnly --outDir dist/types",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@codemirror/commands": "^6.11.1",
    "@codemirror/lang-javascript": "^6.2.5",
    "@codemirror/language": "^6.13.1",
    "@codemirror/search": "^6.7.2",
    "@codemirror/state": "^6.7.6",
    "@codemirror/view": "^6.43.15",
    "@tiptap/core": "^3.35.0",
    "@tiptap/extension-bold": "^3.35.0",
    "@tiptap/extension-document": "^3.35.0",
    "@tiptap/extension-hard-break": "^3.35.0",
    "@tiptap/extension-italic": "^3.35.0",
    "@tiptap/extension-link": "^3.35.0",
    "@tiptap/extension-list": "^3.35.0",
    "@tiptap/extension-paragraph": "^3.35.0",
    "@tiptap/extension-text": "^3.35.0",
    "@tiptap/extensions": "^3.35.0",
    "@tiptap/pm": "^3.35.0"
  }
}
